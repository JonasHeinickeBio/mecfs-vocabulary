# Shapes for release.ttl: a graph release described in DCAT, PROV and VoID.
#
# Targets the Turtle written by ``mecfs_kg.release.rdf.write_release_ttl``. A release is what a
# reader cites, so these check the things a citation depends on: the version, when the data is
# from, which run made it, what it replaced, and that every file in it has a size and a checksum.
#
# Core SHACL only: no sh:sparql (mecfs_kg.validation.shacl_shards returns None for a shape
# directory that uses it, and the graph then has to be validated whole). So "issued on or after
# the day the data was gathered" is not checked: a dateTime and a date do not compare in core SHACL.
#
# Measured against the nine releases on brws039 (2026-10-20.1 to 2026-10-27.3) before any severity
# was set: 2026-10-27.1 to .3 are clean; the six earlier ones raise only the source-snapshot
# Warning below.

@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcat:     <http://www.w3.org/ns/dcat#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix spdx:     <http://spdx.org/rdf/terms#> .
@prefix void:     <http://rdfs.org/ns/void#> .
@prefix aid-pais: <https://w3id.org/mecfs/kg/> .
@prefix mecfssh:  <https://w3id.org/mecfs/kg/shapes/> .


mecfssh:ReleaseDatasetShape a sh:NodeShape ;
    rdfs:label "Release dataset shape" ;
    rdfs:comment "The dcat:Dataset node of one release." ;
    sh:targetClass dcat:Dataset ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ;
        sh:severity sh:Violation ;
        sh:message "A release must have exactly one non-empty dcterms:title." ;
    ] ;
    sh:property [
        sh:path owl:versionInfo ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$" ;
        sh:severity sh:Violation ;
        sh:message "A release version must be YYYY-MM-DD.N (the date and the release number of that day)." ;
    ] ;
    sh:property [
        sh:path dcat:version ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$" ;
        sh:equals owl:versionInfo ;
        sh:severity sh:Violation ;
        sh:message "dcat:version must be YYYY-MM-DD.N and the same value as owl:versionInfo." ;
    ] ;
    sh:property [
        sh:path aid-pais:semanticVersion ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[0-9]+\\.[0-9]+\\.[0-9]+$" ;
        sh:severity sh:Violation ;
        sh:message "mecfs:semanticVersion must be MAJOR.MINOR.PATCH." ;
    ] ;
    sh:property [
        sh:path aid-pais:dataAsOf ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:severity sh:Violation ;
        sh:message "mecfs:dataAsOf must be one xsd:date: the day the data was gathered." ;
    ] ;
    sh:property [
        sh:path dcterms:issued ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message "dcterms:issued must be one xsd:dateTime." ;
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class prov:Activity ;
        sh:severity sh:Violation ;
        sh:message "A release must name exactly one prov:Activity (the run) that generated it." ;
    ] ;
    sh:property [
        sh:path void:triples ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:severity sh:Violation ;
        sh:message "void:triples must be one non-negative integer." ;
    ] ;
    sh:property [
        sh:path aid-pais:paperCount ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:severity sh:Violation ;
        sh:message "mecfs:paperCount must be one non-negative integer." ;
    ] ;
    sh:property [
        sh:path aid-pais:provenanceComplete ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "true" "false" ) ;
        sh:severity sh:Violation ;
        sh:message "mecfs:provenanceComplete must be the string true or false (false lists gaps in the manifest)." ;
    ] ;
    sh:property [
        sh:path prov:wasRevisionOf ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:equals dcterms:replaces ;
        sh:severity sh:Violation ;
        sh:message "A release revises at most one earlier release, and prov:wasRevisionOf and dcterms:replaces must name the same one." ;
    ] ;
    sh:property [
        sh:path dcat:distribution ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class dcat:Distribution ;
        sh:severity sh:Violation ;
        sh:message "A release must list at least one dcat:Distribution (a file)." ;
    ] ;
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class aid-pais:SourceSnapshot ;
        # Warning: the six releases made from runs before 27 October carry no per-source snapshot
        # (those runs recorded no source list); 2026-10-27.1 to .3 do. See RELEASES.md "Partial".
        sh:severity sh:Warning ;
        sh:message "A release should be derived from at least one source snapshot. Releases promoted from runs before the multi-source search record none." ;
    ] .


mecfssh:ReleaseDistributionShape a sh:NodeShape ;
    rdfs:label "Release file shape" ;
    rdfs:comment "One file of a release: its name, size and a SHA-256 checksum." ;
    sh:targetClass dcat:Distribution ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ;
        sh:severity sh:Violation ;
        sh:message "A release file must have exactly one non-empty dcterms:title (its name)." ;
    ] ;
    sh:property [
        sh:path dcat:byteSize ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:severity sh:Violation ;
        sh:message "A release file must have one non-negative integer dcat:byteSize." ;
    ] ;
    sh:property [
        sh:path spdx:checksum ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class spdx:Checksum ;
        sh:severity sh:Violation ;
        sh:message "A release file must have exactly one spdx:Checksum." ;
    ] .


mecfssh:ReleaseChecksumShape a sh:NodeShape ;
    rdfs:label "Release checksum shape" ;
    sh:targetClass spdx:Checksum ;
    sh:property [
        sh:path spdx:algorithm ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:hasValue spdx:checksumAlgorithm_sha256 ;
        sh:severity sh:Violation ;
        sh:message "A release checksum must use SHA-256." ;
    ] ;
    sh:property [
        sh:path spdx:checksumValue ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[0-9a-f]{64}$" ;
        sh:severity sh:Violation ;
        sh:message "A SHA-256 checksum value is 64 lowercase hexadecimal characters." ;
    ] .


mecfssh:ReleaseSourceSnapshotShape a sh:NodeShape ;
    rdfs:label "Release source snapshot shape" ;
    rdfs:comment "What one discovery source returned for the run: how many papers, and when and how it was asked." ;
    sh:targetClass aid-pais:SourceSnapshot ;
    sh:property [
        sh:path aid-pais:sourceName ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ;
        sh:severity sh:Violation ;
        sh:message "A source snapshot must name its source." ;
    ] ;
    sh:property [
        sh:path aid-pais:papersFound ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:severity sh:Violation ;
        sh:message "A source snapshot must have one non-negative integer mecfs:papersFound." ;
    ] ;
    sh:property [
        sh:path prov:generatedAtTime ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message "prov:generatedAtTime on a source snapshot must be one xsd:dateTime." ;
    ] .


mecfssh:ReleaseBuildShape a sh:NodeShape ;
    rdfs:label "Release build activity shape" ;
    sh:targetClass aid-pais:KnowledgeGraphBuild ;
    sh:property [
        sh:path aid-pais:runId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ;
        sh:severity sh:Violation ;
        sh:message "A build activity must carry one mecfs:runId." ;
    ] ;
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class prov:SoftwareAgent ;
        sh:severity sh:Violation ;
        sh:message "A build activity must be associated with the software agent that ran it." ;
    ] ;
    sh:property [
        sh:path prov:startedAtTime ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:lessThanOrEquals prov:endedAtTime ;
        sh:severity sh:Violation ;
        sh:message "prov:startedAtTime must be one xsd:dateTime, not after prov:endedAtTime." ;
    ] ;
    sh:property [
        sh:path prov:endedAtTime ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message "prov:endedAtTime must be one xsd:dateTime." ;
    ] .


mecfssh:ReleaseSoftwareAgentShape a sh:NodeShape ;
    rdfs:label "Release software agent shape" ;
    sh:targetClass prov:SoftwareAgent ;
    sh:property [
        sh:path aid-pais:gitCommit ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[0-9a-f]{40}$" ;
        sh:severity sh:Warning ;
        sh:message "mecfs:gitCommit should be a full 40-character commit hash. A run made outside a git checkout records none, and then the release cannot be tied to code." ;
    ] .
